{
  "expo": {
    "name": "PashuSetu",
    "slug": "pashusetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pashusetu.mobile"
    },
    "android": {
      "package": "com.pashusetu.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PashuSetu to access your camera to take animal photos and videos.",
          "microphonePermission": "Allow PashuSetu to access your microphone to record audio for animal videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PashuSetu to access your photos to select animal images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ddfdd79d-6fcd-4769-bb29-54292636d827"
      }
    }
  }
}
